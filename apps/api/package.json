{
  "name": "@healtrip/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Mohamed Mohsen Shehata",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --watch-path=dist --env-file-if-exists=../../.env dist/main.js",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "db:setup": "node --env-file-if-exists=../../.env dist/database/setup.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@healtrip/contracts": "0.1.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
