# Copy to .env. Everything has a working default; nothing here is required to run the demo.

# Claude. Leave the key empty to run on the rule-based engine instead.
ANTHROPIC_API_KEY=
# LLM_ENGINE=claude            # or rule-based; defaults to claude when a key is set
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Directory. Leave empty to use the in-memory copy of the seed data.
# DATABASE_URL=postgres://healtrip:healtrip@localhost:5432/healtrip

# PORT=4000
# CORS_ORIGIN=http://localhost:3000
# CONVERSATION_TTL_MINUTES=30
# EMERGENCY_NUMBER=997
