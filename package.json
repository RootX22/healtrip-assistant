{
  "name": "healtrip-assistant",
  "private": true,
  "license": "UNLICENSED",
  "author": "Mohamed Mohsen Shehata",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @healtrip/contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @healtrip/contracts && npm run test -w @healtrip/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm run dev -w @healtrip/api",
    "dev:web": "npm run dev -w @healtrip/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
